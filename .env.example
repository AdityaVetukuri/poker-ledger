# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# VITE_SUPABASE_ANON_KEY is the public "anon" key — it is safe to ship in a
# frontend bundle. Row Level Security (see supabase/schema.sql) is what
# actually keeps one user's sessions private from another; never put the
# "service_role" secret key here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
